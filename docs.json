{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Knicks in 5",
  "colors": {
    "primary": "#F58426",
    "light": "#F7A85C",
    "dark": "#DA6A12"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": { "family": "Anton" },
    "body": { "family": "Inter" }
  },
  "banner": {
    "content": "The New York Knicks are NBA champions!",
    "dismissible": true
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "anchors": [
          {
            "anchor": "Watch the Parade",
            "icon": "youtube",
            "href": "https://www.youtube.com/watch?v=DJ0ODjTD3SM"
          },
          {
            "anchor": "NBA.com Recap",
            "icon": "newspaper",
            "href": "https://www.nba.com/news/2026-nba-finals-prove-historically-clutch"
          },
          {
            "anchor": "Changelog",
            "icon": "clock-rotate-left",
            "href": "/changelog"
          }
        ]
      },
      {
        "language": "es",
        "anchors": [
          {
            "anchor": "Ver el Desfile",
            "icon": "youtube",
            "href": "https://www.youtube.com/watch?v=DJ0ODjTD3SM"
          },
          {
            "anchor": "Resumen en NBA.com",
            "icon": "newspaper",
            "href": "https://www.nba.com/news/2026-nba-finals-prove-historically-clutch"
          },
          {
            "anchor": "Registro de Cambios",
            "icon": "clock-rotate-left",
            "href": "/es/changelog"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Go Knicks",
        "href": "https://www.nba.com/knicks"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nyknicks",
      "github": "https://github.com/winderba/Ki5"
    }
  }
}
