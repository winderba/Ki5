{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Knicks in 5",
  "colors": {
    "primary": "#F58426",
    "light": "#F7A85C",
    "dark": "#DA6A12"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": { "family": "Anton" },
    "body": { "family": "Inter" }
  },
  "banner": {
    "content": "The New York Knicks are NBA champions!",
    "dismissible": true
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "pages": [
          { "group": "The Ring", "pages": ["index"] },
          { "group": "The Finals", "pages": ["series", "game4", "numbers"] },
          { "group": "The Celebration", "pages": ["parade", "fans"] },
          { "group": "The Legends", "pages": ["roster"] },
          { "group": "Behind the Banner", "pages": ["colophon", "changelog"] }
        ]
      },
      {
        "language": "es",
        "pages": [
          { "group": "El Anillo", "pages": ["es/index"] },
          { "group": "Las Finales", "pages": ["es/series", "es/game4", "es/numbers"] },
          { "group": "La Celebración", "pages": ["es/parade", "es/fans"] },
          { "group": "Las Leyendas", "pages": ["es/roster"] },
          { "group": "Detrás del Banderín", "pages": ["es/colophon", "es/changelog"] }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Watch the Parade",
          "href": "https://www.youtube.com/watch?v=DJ0ODjTD3SM",
          "icon": "youtube"
        },
        {
          "anchor": "NBA.com Recap",
          "href": "https://www.nba.com/news/2026-nba-finals-prove-historically-clutch",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Go Knicks",
        "href": "https://www.nba.com/knicks"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nyknicks",
      "github": "https://github.com/winderba/Ki5"
    }
  }
}
